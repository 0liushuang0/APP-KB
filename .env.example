# App mode: single (auto login as admin, hide org/permissions) | team (full auth/RBAC/approval)
APP_MODE=single

# Backend
NODE_ENV=development
PORT=3001
JWT_SECRET=change-this-to-a-random-secret-key-at-least-32-characters
# 访问令牌有效期：令牌存在 localStorage/cookie，一次 XSS 不应等于长期接管账号。
# 保持短（2h），过期后由前端用 refreshToken 静默续期。
JWT_EXPIRES_IN=2h
# 刷新令牌有效期（轮换式：每次刷新旧令牌作废，签发新令牌）
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5174

# ============================================================
# 数据库配置
# ============================================================
# 数据库类型: sqlite | postgres
DB_TYPE=sqlite

# SQLite 配置 (DB_TYPE=sqlite 时生效)
SQLITE_PATH=./data/app.db

# PostgreSQL 配置 (DB_TYPE=postgres 时生效)
# 方式1: 使用连接字符串
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aikb
# 方式2: 使用单独配置
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=aikb
DB_SSL=false
# 是否自动运行迁移
MIGRATIONS_RUN=false

# ============================================================
# Redis 配置 (用于缓存和任务队列)
# ============================================================
# 是否启用 Redis（任务队列 BullMQ 依赖它）。单机个人版默认关闭；
# 设为 true 后才会尝试连接下面的 REDIS_HOST/PORT。
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================
# MinIO 对象存储配置
# ============================================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aikb-files
MINIO_USE_SSL=false

# AI Service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=dev-api-key

# Embedding
# basic: local HashingVectorizer, no download, good for offline
# mock: zero vectors for testing
# local: sentence-transformers model (requires HuggingFace download)
# openai: OpenAI Embedding API
EMBEDDING_PROVIDER=basic
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# LLM Provider API Keys
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

GLM_API_KEY=your-glm-api-key
GLM_MODEL=glm-4

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo

# Default admin (single mode)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_NICKNAME=System Admin
DEFAULT_ADMIN_EMAIL=admin@aikb.local

# ============================================================
# 文件加密配置
# ============================================================
# AES-256 加密密钥 (32字节十六进制)
FILE_ENCRYPTION_KEY=
# 是否启用文件加密
FILE_ENCRYPTION_ENABLED=false

# ============================================================
# 文件夹监控配置
# ============================================================
# 监控目录路径
WATCHDOG_DIR=./data/watchdog
# 是否启用文件夹监控
WATCHDOG_ENABLED=false

# ============================================================
# 自动备份配置
# ============================================================
# 是否启用自动备份
AUTO_BACKUP_ENABLED=true
# 自动备份间隔（小时）
AUTO_BACKUP_INTERVAL_HOURS=6
# 保留最近几份自动备份
AUTO_BACKUP_KEEP_COUNT=7

# Frontend
FRONTEND_PORT=5174
VITE_API_BASE_URL=http://localhost:3001/api
