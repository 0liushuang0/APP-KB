# ============================================================
# AI Service 环境变量模板
# 复制本文件为 .env 并填入真实值。切勿把带真实密钥的 .env 提交到版本库。
# 与根目录 .env 共享同一套变量名，后端启动时会同步覆盖本文件。
# ============================================================

# 服务监听。单机产品默认只监听本机（127.0.0.1），避免把一个能解析任意文件、
# 手握用户 API Key 的服务开放给整个局域网。
HOST=127.0.0.1
PORT=8000

# 数据目录（向量库、OCR 模型等）
DATA_DIR=./data/ai

# 后端调用 AI 服务时携带的鉴权头（需与根目录 .env 的 AI_SERVICE_API_KEY 一致）
API_KEY=change-this-to-a-random-key

# 单文件大小上限（MB）
MAX_FILE_SIZE_MB=10

# CORS 允许的来源，逗号分隔；* 表示全开（不推荐生产使用）
CORS_ORIGINS=http://localhost:5174

# ---- Embedding ----
# basic: 本地 HashingVectorizer（768 维，无需下载，离线可用）
# mock: 全零向量，仅供测试
# local: sentence-transformers（默认 BAAI/bge-small-zh-v1.5，512 维，首次需下载）
# openai: OpenAI text-embedding-3-small（1536 维，需联网）
# 注意：不同 provider 维度不同，切换后需清空向量库重建索引。
EMBEDDING_PROVIDER=basic
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=5

# ---- LLM Providers（按需填写，留空则该 provider 不可用）----
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

GLM_API_KEY=
GLM_MODEL=glm-4
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Ollama 本地模型（离线降级，可选）----
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_API_KEY=ollama

# ---- 数据出境策略 ----
# cloud：允许调用云端大模型；local_only：只允许回环地址，硬性阻断出网
EGRESS_MODE=cloud
# 出境前脱敏（联系方式 + 自定义敏感词）；本地模型不受影响
EGRESS_SANITIZE=true
# 自定义敏感词，逗号分隔，例如客户单位全称、项目代号
EGRESS_REDACT_TERMS=
# 出境台账：只记元数据，不记正文
EGRESS_LOG_ENABLED=true
